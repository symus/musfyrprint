# Copy to .env and replace every placeholder. Never commit real values.

# --- Database -------------------------------------------------------------
POSTGRES_DB=musfyr
POSTGRES_USER=musfyr
POSTGRES_PASSWORD=change-me-strong-db-password
DB_URL=jdbc:postgresql://postgres:5432/musfyr
DB_USERNAME=musfyr
DB_PASSWORD=change-me-strong-db-password

# --- Backend security -----------------------------------------------------
# At least 32 random bytes, e.g. `openssl rand -base64 48`
JWT_SECRET=replace-with-at-least-32-random-bytes
ACCESS_TOKEN_TTL=PT2H
COOKIE_SECURE=true
CORS_ALLOWED_ORIGINS=https://shop.example.com
# Creates the first administrator on first start; remove afterwards.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-unique-password

# --- Brand & market (backend) -------------------------------------------------
BRAND_NAME=musfyr print
BRAND_TAGLINE=Create It. Wear It. Stick It.
BRAND_SUPPORT_EMAIL=hello@example.com
BRAND_SUPPORT_PHONE=+48 000 000 000
BRAND_ADDRESS=Company name, street, postcode city, Poland
DEFAULT_CURRENCY=PLN
DEFAULT_LOCALE=pl-PL
SUPPORTED_CURRENCIES=PLN,EUR
SUPPORTED_LOCALES=pl-PL,en-GB

# --- Frontend (build time) -------------------------------------------------
NEXT_PUBLIC_BRAND_NAME=musfyr print
NEXT_PUBLIC_SITE_URL=https://shop.example.com
NEXT_PUBLIC_SUPPORT_EMAIL=hello@example.com
NEXT_PUBLIC_SUPPORT_PHONE=+48 000 000 000
NEXT_PUBLIC_COMPANY_ADDRESS=Company name, street, postcode city, Poland
# Frontend (runtime): where the Next.js server reaches the API
API_INTERNAL_URL=http://backend:8080

# --- Integrations (later phases; leave empty until configured) ---------------
# OAuth (Phase 3)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Payments (Phase 3)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
P24_MERCHANT_ID=
P24_CRC_KEY=
P24_API_KEY=
# Messaging (Phase 4)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMS_PROVIDER_API_KEY=
# Shipping (Phase 4)
INPOST_API_TOKEN=
DHL_API_KEY=
# Object storage for artwork (Phase 2)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
