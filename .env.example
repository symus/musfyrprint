# Copy to .env and replace every placeholder. Never commit real values.

# --- Database -------------------------------------------------------------
POSTGRES_DB=musfyr
POSTGRES_USER=musfyr
POSTGRES_PASSWORD=change-me-strong-db-password
DB_URL=jdbc:postgresql://postgres:5432/musfyr
DB_USERNAME=musfyr
DB_PASSWORD=change-me-strong-db-password

# --- Backend security -----------------------------------------------------
# At least 32 random bytes, e.g. `openssl rand -base64 48`
JWT_SECRET=replace-with-at-least-32-random-bytes
ACCESS_TOKEN_TTL=PT2H
COOKIE_SECURE=true
CORS_ALLOWED_ORIGINS=https://shop.example.com
# Creates the first administrator on first start; remove afterwards.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-unique-password

# --- Brand & market (backend) -------------------------------------------------
BRAND_NAME=Musfir Print
BRAND_TAGLINE=Create It. Wear It. Stick It.
BRAND_SUPPORT_EMAIL=hello@example.com
BRAND_SUPPORT_PHONE=+48 000 000 000
BRAND_ADDRESS=Company name, street, postcode city, Poland
DEFAULT_CURRENCY=PLN
DEFAULT_LOCALE=pl-PL
SUPPORTED_CURRENCIES=PLN,EUR
SUPPORTED_LOCALES=pl-PL,en-GB

# --- Frontend (build time) -------------------------------------------------
NEXT_PUBLIC_BRAND_NAME=Musfir Print
NEXT_PUBLIC_SITE_URL=https://shop.example.com
NEXT_PUBLIC_SUPPORT_EMAIL=hello@example.com
NEXT_PUBLIC_SUPPORT_PHONE=+48 000 000 000
NEXT_PUBLIC_COMPANY_ADDRESS=Company name, street, postcode city, Poland
# Frontend (runtime): where the Next.js server reaches the API
API_INTERNAL_URL=http://backend:8080

# --- Shop (backend) -------------------------------------------------------------
# Public addresses used in e-mail links and the Przelewy24 return/notification URLs.
PUBLIC_SITE_URL=https://shop.example.com
PUBLIC_API_URL=https://api.example.com
# EXEMPT = not VAT-registered (art. 113, no VAT shown or charged); STANDARD = prices include VAT at TAX_STANDARD_RATE
TAX_MODE=EXEMPT
TAX_STANDARD_RATE=23
MAIL_FROM=no-reply@example.com

# --- Przelewy24 (backend) --------------------------------------------------------
# DISABLED (checkout refuses payment) | SIMULATOR (built-in test page, no money; dev/demo only)
# | SANDBOX (sandbox.przelewy24.pl) | PRODUCTION (secure.przelewy24.pl)
P24_MODE=DISABLED
P24_MERCHANT_ID=
P24_POS_ID=
# From the P24 panel: "Moje dane" → "Klucz do raportów" (API key) and "Klucz CRC"
P24_API_KEY=
P24_CRC_KEY=
# Optional comma-separated allowlist of P24 notification source IPs (signatures are always verified)
P24_NOTIFICATION_IPS=

# --- E-mail (backend) – without SPRING_MAIL_HOST, e-mails are only logged ---------
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true

# --- Integrations (later phases; leave empty until configured) ---------------
# OAuth (Phase 3)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Further payment providers (not implemented yet)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Messaging (Phase 4)
SMS_PROVIDER_API_KEY=
# Shipping (Phase 4)
INPOST_API_TOKEN=
DHL_API_KEY=
# Object storage for artwork (Phase 2)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
